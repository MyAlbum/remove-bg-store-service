# Standalone API base URL used to build returned absolute URLs.
NEXT_PUBLIC_URL=http://localhost:8000

# Upstream local remove-bg worker URL.
REMOVE_BG_LOCAL_URL=http://127.0.0.1:7860

# Defaults kept in sync with current Next.js route.
REMOVE_BG_MODEL=bria-rmbg-2.0
NEXT_PUBLIC_REMOVE_BG_ALPHA_MATTING_FG_THRESHOLD=200
NEXT_PUBLIC_REMOVE_BG_ALPHA_MATTING_BG_THRESHOLD=40
NEXT_PUBLIC_REMOVE_BG_ALPHA_MATTING_ERODE_SIZE=8
NEXT_PUBLIC_REMOVE_BG_EDGE_FEATHER_PX=0.2
